@model IEnumerable<AutoServiceWeb.Models.Vehicle>

@{
    ViewData["Title"] = "Avtomobillər";
}

<div class="container mt-4">
    <h2>Avtomobillər</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Yeni avtomobil əlavə et
    </a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Marka</th>
                <th>Model</th>
                <th>İl</th>
                <th>Dövlət nömrəsi</th>
                <th>Müştəri</th>
                <th>Telefon</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Brand</td>
                    <td>@item.Model</td>
                    <td>@item.Year</td>
                    <td>@item.LicensePlate</td>
                    <td>@item.CustomerName</td>
                    <td>@item.Phone</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Bax</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Redaktə</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>