@model IEnumerable<AutoServiceWeb.Models.ServiceOrder>

@{
    ViewData["Title"] = "Servis sifarişləri";
}

<div class="container mt-4">
    <h2>Servis sifarişləri</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">
        Yeni sifariş yarat
    </a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Avtomobil</th>
                <th>Xidmət növü</th>
                <th>Problem</th>
                <th>Qiymət</th>
                <th>Tarix</th>
                <th>Status</th>
                <th>Əməliyyatlar</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Vehicle?.Brand @item.Vehicle?.Model</td>
                    <td>@item.ServiceType</td>
                    <td>@item.ProblemDescription</td>
                    <td>@item.Price AZN</td>
                    <td>@item.Date.ToString("dd.MM.yyyy")</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Redaktə</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>